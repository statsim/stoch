{
  "name": "stoch",
  "version": "0.0.2",
  "description": "Probabilistic programming library powered by TensorFlow.js",
  "main": "dist/stoch.cjs.js",
  "module": "src/index.js",
  "browser": "dist/stoch.min.js",
  "scripts": {
    "build-dev": "webpack --mode development",
    "build": "webpack --mode production && npm run test:unit",
    "test:unit": "node --experimental-vm-modules ./node_modules/.bin/jest tests/unit --forceExit",
    "test:reference": "node --experimental-vm-modules ./node_modules/.bin/jest tests/reference --forceExit",
    "generate-data": "python3 scripts/generate-reference-data.py",
    "bench": "node benchmarks/run.js",
    "bench:gpu": "node benchmarks/run.js --gpu",
    "bench:native": "node benchmarks/run.js --native"
  },
  "keywords": [
    "tensorflow",
    "probability",
    "probabilistic-programming",
    "bayesian",
    "statistics",
    "distributions",
    "machine-learning"
  ],
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "author": "Anton Zemlyansky",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/statsim/stoch.git"
  },
  "bugs": {
    "url": "https://github.com/statsim/stoch/issues"
  },
  "homepage": "https://github.com/statsim/stoch#readme",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@jseeio/jsee": "^0.4.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@tensorflow/tfjs-node-gpu": "^4.22.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "benchmark": "^2.1.4",
    "jest": "^29.7.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
